      "最大边长": 768,
      "最大生成token": 4096,
      "温度": 0.6,
      "top_p": 0.9,
      "top_k": 20,
      "重复惩罚": 1,
      "频率惩罚": 0,
      "存在惩罚": 0,
      "seed": 0,
      "输出think块": false,
      "生成后自动卸载模型": true
